// SOFTWARE TO RUN AN ESP32 TO PERFORM THE TASK OF DETECTING FIRES AND GIVING LOCALIZED ALERTS AND WIRELESS ALERTS VIA WHATSAPP USING CALLMEBOT API

// Importing necessary libraries 
#include <WiFi.h>
#include <HTTPClient.h>
#include "DHT.h"

// Wi-Fi credentials
const char* ssid = "FIRE_ALARM";  // Wi-Fi hotspot name        
const char* password = "fire_alarm"; //Wi-Fi hotspot password

// Phone numbers and API keys
// Array of API keys corresponding to each phone number
String phone_numbers[] = {"234...9", "234...5", "234...0", "234...3", "234...5"};
String api_keys[] = {"3***5", "2***4", "2***5", "9***6", "9***6"};
const int num_phone_numbers = sizeof(phone_numbers) / sizeof(phone_numbers[0]);

// Sensor thresholds
const int smokeThreshold = 1450; // In ppm
const int highSmokeThreshold = 1480; // In ppm
const float tempThreshold = 60.0; // In °C

// Sensor pins 
// Defining the pins in which various sensors and indicators are connected to the ESP32-DEVKITV1
const int smokeSensorPin = 34; //smokesensor 
const int flameSensorPin = 14; //flame sensor
const int dhtPin = 32; //thermal sensor
const int wifiConnectedLED = 2; //Wi-Fi connected LED
const int fireDetectedLED = 4; // Visual alert LED
const int buzzerPin = 5; // Buzzer LED
const int powerIndicatorLED = 15; // Power indicator LED

// DHT sensor setup
// Thermal sensors initialization
#define DHTTYPE DHT22
DHT dht(dhtPin, DHTTYPE);

// Timing variables
unsigned long lastAlertTime = 0;
const unsigned long alertCooldown = 45000; // 1-minute cooldown
unsigned long lastWiFiAttempt = 0;
const unsigned long wifiRetryInterval = 30000; // 30 seconds retry

// SETTING FUNCTIONS TO SENSORS
void setup() {
    Serial.begin(9600); // "9600" is baud rate of serial monitor
    pinMode(smokeSensorPin, INPUT); // set smoke sensors as input
    pinMode(flameSensorPin, INPUT); // set flame sensor as input 
    pinMode(wifiConnectedLED, OUTPUT); // set Wi-Fi connection LED as ouptut
    pinMode(fireDetectedLED, OUTPUT); // set fire detected LED as output
    pinMode(buzzerPin, OUTPUT); // set buzzer as ouput 
    pinMode(powerIndicatorLED, OUTPUT); // Set power indicator LED as output
    
    dht.begin(); // Initialize DHT22 sensor

    // Turn off all indicators initially
    digitalWrite(wifiConnectedLED, LOW);
    digitalWrite(fireDetectedLED, LOW);
    digitalWrite(buzzerPin, LOW);
    
    delay(1000); // 1-second delay before turning on power indicator LED
    digitalWrite(powerIndicatorLED, HIGH); // Power indicator LED ON when powered
    
    connectToWiFi();
}

void loop() {
    if (WiFi.status() != WL_CONNECTED && millis() - lastWiFiAttempt > wifiRetryInterval) {
        connectToWiFi();
    }
    
    int smokeLevel = analogRead(smokeSensorPin);
    int flameDetected = digitalRead(flameSensorPin);
    float temperature = dht.readTemperature();
    
    Serial.print("Smoke Level: "); Serial.println(smokeLevel);
    Serial.print("Temperature: "); Serial.println(temperature);
    Serial.print("Flame Detected: "); Serial.println(flameDetected);
    
    bool fireCondition = (smokeLevel > highSmokeThreshold) || (temperature > tempThreshold) || (flameDetected == 1 && (temperature > tempThreshold || smokeLevel > highSmokeThreshold));

    if (fireCondition && millis() - lastAlertTime > alertCooldown) {
        sendWarningMessage();
        triggerAlarm();
        lastAlertTime = millis();
    }
    
    delay(2000);
}

// Wi-Fi connection protocols
void connectToWiFi() {
    Serial.print("Connecting to Wi-Fi");
    WiFi.begin(ssid, password);
    lastWiFiAttempt = millis();
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 20) {
        delay(500);
        Serial.print(".");
        attempts++;
    }
    
    if (WiFi.status() == WL_CONNECTED) {
        Serial.println("\nConnected to Wi-Fi!");
        digitalWrite(wifiConnectedLED, HIGH);
    } else {
        Serial.println("\nWi-Fi Connection Failed!");
        digitalWrite(wifiConnectedLED, LOW); // Turn off WiFi LED when disconnected
    }
}

// Sending alert messages to stakeholders
void sendWarningMessage() {
    if (WiFi.status() == WL_CONNECTED) { 
        digitalWrite(wifiConnectedLED, HIGH); // Turn on WiFi LED when WiFi is back
        HTTPClient http;
        
        for (int i = 0; i < num_phone_numbers; i++) {
            String apiURL = "https://api.callmebot.com/whatsapp.php?phone=" + phone_numbers[i] 
            + "&text=Warning:+Fire+Detected!+And+Fire+Alarm+Triggered!+Please+Investigate+And+Take+Necessary+Actions+Evacuate+Immediately!&apikey=" + api_keys[i];
            http.begin(apiURL);
            int httpResponseCode = http.GET();
            
            if (httpResponseCode > 0) {
                Serial.print("Message sent successfully to ");
                Serial.println(phone_numbers[i]);
            } else {
                Serial.print("Error sending message to ");
                Serial.println(phone_numbers[i]);
            }
            http.end();
            delay(1000);
        }
    } else {
        Serial.println("Error: Wi-Fi not connected!");
        digitalWrite(wifiConnectedLED, LOW); // Ensure WiFi LED is off when disconnected
    }
}

// Trigger Alarm 
void triggerAlarm() {
    unsigned long alarmStart = millis();
    while (millis() - alarmStart < 60000) { // Run for 60 seconds
        digitalWrite(fireDetectedLED, HIGH);
        digitalWrite(buzzerPin, HIGH);
        delay(100);
        digitalWrite(fireDetectedLED, LOW);
        digitalWrite(buzzerPin, LOW);
        delay(100);
    }
}
